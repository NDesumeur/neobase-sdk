{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin NeoBase",
  "type": "object",
  "required": ["id", "name", "version", "author", "entry", "view", "neobase", "type"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$", "description": "identifiant unique, style auteur.nom" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 200 },
    "icon": { "type": "string" },
    "entry": { "type": "string", "default": "index.js" },
    "view": { "type": "string", "pattern": "^[a-zA-Z][\\w-]*$" },
    "neobase": { "type": "string", "description": "plage semver des versions de NeoBase compatibles" },
    "type": { "enum": ["app", "mod"] },
    "category": { "type": "string" },
    "mobile": { "type": "boolean", "default": false },
    "system": { "type": "boolean", "default": false },
    "uses": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$" }, "description": "plugins dont celui-ci lit les données (permission data:<id>)" },
    "dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
    "permissions": { "type": "array", "items": { "enum": ["storage", "files", "network", "clipboard", "notifications", "full"] }, "uniqueItems": true }
  }
}
